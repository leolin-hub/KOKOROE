# 複製成同目錄的 .env 再填值：cp .env.example .env && chmod 600 .env
# .env 已經在 .gitignore 裡，絕對不要 commit。
# backup.sh 會把這個檔案當 shell 執行：值裡有空白、$ 或反引號時，用單引號包起來。

# ---- PostgreSQL ----
DB_NAME=kokoroe
DB_USER=kokoroe
# 產生方式：openssl rand -base64 32 | tr -d '/+='
DB_PASSWORD=

# ---- Cloudflare R2：照片 ----
# Cloudflare 後台 → R2 → 右側的 Account ID
STORAGE_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
STORAGE_BUCKET=kokoroe-photos
# R2 → Manage API tokens → 權限選 Object Read & Write，只套用在 kokoroe-photos 這一個 bucket
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ---- Cloudflare R2：資料庫備份（backup.sh 用）----
# 跟照片分開一個 bucket、一組金鑰：照片的金鑰外洩時，備份不會跟著被刪
BACKUP_BUCKET=kokoroe-backups
BACKUP_ACCESS_KEY=
BACKUP_SECRET_KEY=
# 選填：每次備份成功時打一下這個網址（例如 healthchecks.io），哪天沒打就寄信通知
# BACKUP_PING_URL=

# ---- 選填 ----
# 要跑的 image 版本（git commit SHA）。deploy.yml 每次部署會自動改寫這一行；
# 手動回滾就是把它改成舊的 SHA 再 docker compose up -d。不填就是 latest。
# IMAGE_TAG=
# Caddy 綁在 127.0.0.1 的哪個 port，要跟 Cloudflare Tunnel 的 Service URL 一致
# WEB_PORT=8080
